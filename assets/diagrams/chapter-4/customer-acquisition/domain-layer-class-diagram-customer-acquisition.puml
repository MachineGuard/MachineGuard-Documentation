package "Modelo de dominio" as ModeloDominio {
class PilotRequest <<Raíz de agregado>> {
  -id: UUID
  -companyName: String
  -contactName: String
  -contactEmail: String
  -contactPhone: String
  -industry: String
  -estimatedMonthlyLoss: BigDecimal
  -status: PilotRequestStatus
  -submittedAt: Instant
  +submit(): PilotRequest
  +markAsContacted(): void
  +convert(): void
  +isPending(): boolean
}

enum PilotRequestStatus <<Objeto de valor>> {
  PENDING
  CONTACTED
  CONVERTED
}
}

package "Puertos de repositorio" as PuertosRepositorio {
interface PilotRequestRepository <<Repositorio>> {
  +save(pilotRequest: PilotRequest): PilotRequest
  +findById(id: UUID): Optional<PilotRequest>
  +findByStatus(status: PilotRequestStatus): List<PilotRequest>
}
}

