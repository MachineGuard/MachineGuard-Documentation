@startuml
title Diagrama de base de datos — Contexto Customer Acquisition

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classBorderColor #4A5568
skinparam classBackgroundColor #F8FAFC
skinparam ArrowColor #4A5568
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
hide methods
hide stereotypes

entity pilot_requests {
  * id : UUID <<PK>>
  --
  * company_name : VARCHAR(150)
  * contact_name : VARCHAR(150)
  * contact_email : CITEXT
  * contact_phone : VARCHAR(30)
  * industry : VARCHAR(100)
  estimated_monthly_loss : NUMERIC(12,2)
  * status : VARCHAR(20) {PENDING | CONTACTED | CONVERTED}
  * submitted_at : TIMESTAMPTZ
}

note bottom of pilot_requests
  Tabla sin Foreign Keys hacia otros Bounded Contexts:
  los datos de contacto se transmiten a IAM unicamente
  mediante el evento PilotRequestSubmitted, no por
  referencia de base de datos.
end note
@enduml
