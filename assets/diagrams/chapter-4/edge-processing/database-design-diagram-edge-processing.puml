@startuml
title Diagrama de base de datos — Contexto Edge Processing (SQLite en el Edge Gateway)

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classBorderColor #4A5568
skinparam classBackgroundColor #F8FAFC
skinparam ArrowColor #4A5568
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
hide methods
hide stereotypes

entity calibration_profiles {
  * id : INTEGER <<PK>>
  --
  * sensor_node_id : VARCHAR(255) <<UQ>>
  * temperature_offset : REAL
  * humidity_offset : REAL
  * temperature_min : REAL
  * temperature_max : REAL
  * humidity_min : REAL
  * humidity_max : REAL
  * sampling_interval_seconds : INTEGER
  * calibrated_at : DATETIME
  * updated_at : DATETIME
}

entity sensor_readings {
  * id : INTEGER <<PK>>
  --
  * sensor_node_id : VARCHAR(255)
  calibration_profile_id : INTEGER <<FK>>
  * raw_temperature : REAL
  * raw_humidity : REAL
  calibrated_temperature : REAL
  calibrated_humidity : REAL
  * captured_at : DATETIME
  * status : VARCHAR(255) {CAPTURED | CALIBRATED | DISCARDED | SYNCED}
}

entity local_buffer_entries {
  * id : INTEGER <<PK>>
  --
  * sensor_reading_id : INTEGER <<FK, UQ>>
  * gateway_id : VARCHAR(255)
  * enqueued_at : DATETIME
}

entity offline_nodes {
  * id : INTEGER <<PK>>
  --
  * sensor_node_id : VARCHAR(255)
  * last_seen_at : DATETIME
  * expected_sampling_interval : INTEGER
  * detected_at : DATETIME
  restored_at : DATETIME
}

entity sync_state {
  * gateway_id : VARCHAR(255) <<PK>>
  --
  last_sync_at : DATETIME
}

calibration_profiles "1" -down-> "0..*" sensor_readings
sensor_readings "1" -right-> "0..1" local_buffer_entries

note bottom of offline_nodes
  Conserva un registro por cada periodo de
  indisponibilidad detectado para un nodo.
  sensor_node_id y gateway_id son referencias
  logicas al modelo central de MachineGuard,
  no Foreign Keys fisicas: la base local del gateway
  es independiente de PostgreSQL.
end note

note bottom of sensor_readings
  Indices sobre sensor_node_id y captured_at para
  consultar las ultimas lecturas y sincronizar en
  orden cronologico ascendente.
end note

note bottom of sync_state
  Una fila por gateway con la marca temporal de
  la ultima sincronizacion del Local Buffer.
end note
@enduml
